<?xml version="1.0"?>
<sdf version="1.9">
  <world name="acc_world">
    <physics name="default_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <direction>-0.5 0.1 -0.9</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>200 20</size></plane></geometry>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>200 20</size></plane></geometry>
          <material><ambient>0.25 0.25 0.25 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="test_obstacle">
      <static>true</static>
      <pose>18 0 0.75 0 0 0</pose>
      <link name="obstacle_link">
        <collision name="obstacle_collision">
          <geometry><box><size>1.5 1.8 1.5</size></box></geometry>
        </collision>
        <visual name="obstacle_visual">
          <geometry><box><size>1.5 1.8 1.5</size></box></geometry>
          <material><ambient>0.75 0.12 0.08 1</ambient><diffuse>0.85 0.15 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="acc_vehicle">
      <pose>0 0 0.18 0 0 0</pose>

      <link name="base_link">
        <inertial>
          <mass>35</mass>
          <inertia>
            <ixx>1.2</ixx><iyy>2.0</iyy><izz>2.5</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="chassis_collision">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.9 0.55 0.22</size></box></geometry>
        </collision>
        <visual name="chassis_visual">
          <pose>0 0 0.12 0 0 0</pose>
          <geometry><box><size>0.9 0.55 0.22</size></box></geometry>
          <material><ambient>0.08 0.2 0.65 1</ambient><diffuse>0.1 0.3 0.9 1</diffuse></material>
        </visual>
      </link>

      <link name="left_wheel">
        <pose>0 0.32 0 1.570796 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="left_wheel_collision">
          <geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="left_wheel_visual">
          <geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry>
          <material><diffuse>0.04 0.04 0.04 1</diffuse></material>
        </visual>
      </link>

      <link name="right_wheel">
        <pose>0 -0.32 0 1.570796 0 0</pose>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <collision name="right_wheel_collision">
          <geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry>
        </collision>
        <visual name="right_wheel_visual">
          <geometry><cylinder><radius>0.18</radius><length>0.08</length></cylinder></geometry>
          <material><diffuse>0.04 0.04 0.04 1</diffuse></material>
        </visual>
      </link>

      <joint name="left_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>left_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1000000</lower><upper>1000000</upper></limit>
        </axis>
      </joint>
      <joint name="right_wheel_joint" type="revolute">
        <parent>base_link</parent>
        <child>right_wheel</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-1000000</lower><upper>1000000</upper></limit>
        </axis>
      </joint>

      <link name="lidar_link">
        <pose>0.28 0 0.42 0 0 0</pose>
        <inertial>
          <mass>0.1</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
            <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
          </inertia>
        </inertial>
        <sensor name="front_lidar" type="gpu_lidar">
          <topic>/scan</topic>
          <update_rate>15</update_rate>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range><min>0.12</min><max>30.0</max><resolution>0.01</resolution></range>
          </lidar>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
      </link>
      <joint name="lidar_joint" type="fixed">
        <parent>base_link</parent>
        <child>lidar_link</child>
      </joint>

      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.64</wheel_separation>
        <wheel_radius>0.18</wheel_radius>
        <topic>/model/acc_vehicle/cmd_vel</topic>
        <odom_topic>/model/acc_vehicle/odometry</odom_topic>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <odom_publish_frequency>30</odom_publish_frequency>
      </plugin>
    </model>
  </world>
</sdf>
